{
  "description": "Negative: an unused variable fails the build because warnings are errors",
  "includes": ["cpp-basic"],
  "steps": [
    "cmake-configure",
    {
      "preset": "cmake-build",
      "cmd": ["cmake", "--build", "@BUILD_DIR@", "--config", "Release"],
      "expect": "fail",
      "expect_output": "unused"
    }
  ]
}
