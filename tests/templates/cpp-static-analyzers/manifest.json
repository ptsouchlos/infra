{
  "description": "cppcheck, clang-tidy and include-what-you-use run during the build",
  "includes": ["_cpp_common"],
  "skip_on": ["windows", "darwin"],
  "requires": {"all": ["cppcheck", "clang-tidy", "include-what-you-use"]},
  "steps": [
    {"preset": "cmake-configure", "expect_output": "Also setting clang-tidy globally"},
    {"preset": "cmake-build", "expect_output": "cppcheck"},
    "cmake-test"
  ]
}
