{
  "version": 6,
  "include": ["@INFRA_DIR@/cpp/presets/CMakePresets.json"],
  "configurePresets": [
    {
      "name": "consumer",
      "hidden": true,
      "environment": {"PT_INFRA_DIR": "@INFRA_DIR@"}
    },
    {
      "name": "composed",
      "inherits": ["consumer", "ninja", "toolchain-@TOOLCHAIN@", "type-release"],
      "cacheVariables": {"CMAKE_CXX_STANDARD": "20"}
    }
  ],
  "buildPresets": [{"name": "composed", "configurePreset": "composed"}],
  "testPresets": [
    {"name": "composed", "configurePreset": "composed", "output": {"outputOnFailure": true}}
  ]
}
