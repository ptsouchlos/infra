    },
    {
      "name": "clang-libcxx-release",
      "configurePreset": "clang-libcxx-release",
      "inherits": "host-linux"
    },
    {
      "name": "clang-libcxx-maxsan",
      "configurePreset": "clang-libcxx-maxsan",
      "inherits": "host-linux"
    },
    {"name": "clang-libcxx-tsan", "configurePreset": "clang-libcxx-tsan", "inherits": "host-linux"},
    {"name": "appleclang-debug", "configurePreset": "appleclang-debug", "inherits": "host-macos"},
    {
      "name": "appleclang-release",
      "configurePreset": "appleclang-release",
      "inherits": "host-macos"
    },
    {
      "name": "appleclang-relwithdebinfo",
      "configurePreset": "appleclang-relwithdebinfo",
      "inherits": "host-macos"
    },
    {"name": "appleclang-maxsan", "configurePreset": "appleclang-maxsan", "inherits": "host-macos"},
    {"name": "appleclang-tsan", "configurePreset": "appleclang-tsan", "inherits": "host-macos"},
    {
      "name": "appleclang-debug-vcpkg",
