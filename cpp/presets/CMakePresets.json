    {
      "name": "clang-relwithdebinfo",
      "configurePreset": "clang-relwithdebinfo",
      "inherits": "host-not-macos"
    },
    {"name": "clang-maxsan", "configurePreset": "clang-maxsan", "inherits": "host-linux"},
    {"name": "clang-tsan", "configurePreset": "clang-tsan", "inherits": "host-linux"},
    {
      "name": "clang-debug-vcpkg",
      "configurePreset": "clang-debug-vcpkg",
      "inherits": "host-not-macos"
    },
    {
      "name": "clang-release-vcpkg",
      "configurePreset": "clang-release-vcpkg",
      "inherits": "host-not-macos"
    },
    {
      "name": "clang-libcxx-debug",
      "configurePreset": "clang-libcxx-debug",
